     def select_arterial(self, event):
        self.save_history()
        x, y = event.xdata, event.ydata
        click_point = Point(x, y)
        min_dist = float('inf')
        nearest_node = None
        for node_id, node_data in self.nodes.iterrows():
            node_geom = node_data.geometry
            dist = node_geom.distance(click_point)
            if dist < min_dist:
                min_dist = dist
                nearest_node = node_id
        if nearest_node is not None and min_dist < 100:
            self.temp_edge.append(nearest_node)
            if len(self.temp_edge) == 2:
                start_node, end_node = self.temp_edge
                path = self.find_shortest_path(start_node, end_node)
                if path:
                    if not hasattr(self, 'selected_path_nodes'):
                        self.selected_path_nodes = set()
                    for u, v, k in self.arterial_edges:
                        self.selected_path_nodes.add(u)
                        self.selected_path_nodes.add(v)
                    path_set = set(path)
                    self.selected_nodes.add(start_node)
                    self.selected_nodes.add(end_node)
                    common_nodes = path_set & self.selected_path_nodes
                    for node in common_nodes:
                        self.selected_nodes.add(node)
                    self.selected_path_nodes.update(path_set)
                    for i in range(len(path) - 1):
                        u, v = path[i], path[i + 1]
                        if self.original_G.has_edge(u, v):
                            for k in self.original_G.get_edge_data(u, v).keys():
                                self.selected_edges.add((u, v, k))
                                self.arterial_edges.add((u, v, k))
                self.temp_edge = []
            self.draw_map()

    def find_shortest_path(self, start_node, end_node):
        try:
            path = nx.shortest_path(self.original_G, start_node, end_node, weight='length')
            return path
        except nx.NetworkXNoPath:
            print(f"There is NO edge from node {start_node} to {end_node}")
            return None

    def calculate_all_distances(self, event):
        """分别计算每个需求点到一级集合点和二级集合点的最短距离"""

        if not self.primary_gathering_points and not self.secondary_gathering_points:
            print("错误：没有选择集合点，请先选择一级或二级集合点")
            return

        if not self.region_centroid_nodes:
            print("错误：没有发现小区，请先完成选择以识别小区")
            return

        print("\n" + "=" * 60)
        print("开始计算距离矩阵")
        print("=" * 60)
        print(f"需求点数量: {len(self.region_centroid_nodes)}")
        print(f"一级集合点数量: {len(self.primary_gathering_points)}")
        print(f"二级集合点数量: {len(self.secondary_gathering_points)}")
        print(f"使用路网: 完整OSM路网 ({len(self.original_G.nodes)} 个节点)")

        # 初始化存储结构
        centroid_ids = [node_id for node_id, _ in self.region_centroid_nodes]

        # 一级集合点距离矩阵
        self.primary_distance_matrix = None
        self.primary_shortest_paths = {}

        # 二级集合点距离矩阵
        self.secondary_distance_matrix = None
        self.secondary_shortest_paths = {}

        # === 计算到一级集合点的距离 ===
        if self.primary_gathering_points:
            print("\n" + "=" * 60)
            print("【计算到一级集合点的距离】")
            print("=" * 60)

            primary_gp_ids = list(self.primary_gathering_points)
            self.primary_distance_matrix = pd.DataFrame(
                index=centroid_ids,
                columns=primary_gp_ids,
                dtype=float
            )
            self.primary_distance_matrix[:] = float('inf')

            for i, (centroid_id, centroid_geom) in enumerate(self.region_centroid_nodes):
                print(f"\n【需求点 {i + 1}】- Node ID: {centroid_id}")
                print(f"坐标: ({centroid_geom.x:.1f}, {centroid_geom.y:.1f})")

                try:
                    distances, paths = nx.single_source_dijkstra(
                        self.original_G,
                        centroid_id,
                        weight='length'
                    )
                    print(f"从该需求点可达 {len(distances)} 个节点")

                    for j, gathering_point in enumerate(primary_gp_ids):
                        if gathering_point in distances:
                            distance = distances[gathering_point]
                            path = paths[gathering_point]

                            self.primary_distance_matrix.loc[centroid_id, gathering_point] = distance
                            self.primary_shortest_paths[(centroid_id, gathering_point)] = path

                            capacity = self.primary_capacities.get(gathering_point, "未设置")
                            print(f"  ├─ 一级集合点 {gathering_point}: {distance:.1f}米 "
                                  f"(容量: {capacity}, 路径经过 {len(path)} 个节点)")
                        else:
                            print(f"  ├─ 一级集合点 {gathering_point}: 不可达")
                except Exception as e:
                    print(f"  ❌ 计算失败: {e}")

        # === 计算到二级集合点的距离 ===
        if self.secondary_gathering_points:
            print("\n" + "=" * 60)
            print("【计算到二级集合点的距离】")
            print("=" * 60)

            secondary_gp_ids = list(self.secondary_gathering_points)
            self.secondary_distance_matrix = pd.DataFrame(
                index=centroid_ids,
                columns=secondary_gp_ids,
                dtype=float
            )
            self.secondary_distance_matrix[:] = float('inf')

            for i, (centroid_id, centroid_geom) in enumerate(self.region_centroid_nodes):
                print(f"\n【需求点 {i + 1}】- Node ID: {centroid_id}")
                print(f"坐标: ({centroid_geom.x:.1f}, {centroid_geom.y:.1f})")

                try:
                    distances, paths = nx.single_source_dijkstra(
                        self.original_G,
                        centroid_id,
                        weight='length'
                    )
                    print(f"从该需求点可达 {len(distances)} 个节点")

                    for j, gathering_point in enumerate(secondary_gp_ids):
                        if gathering_point in distances:
                            distance = distances[gathering_point]
                            path = paths[gathering_point]

                            self.secondary_distance_matrix.loc[centroid_id, gathering_point] = distance
                            self.secondary_shortest_paths[(centroid_id, gathering_point)] = path

                            capacity = self.secondary_capacities.get(gathering_point, "未设置")
                            print(f"  ├─ 二级集合点 {gathering_point}: {distance:.1f}米 "
                                  f"(容量: {capacity}, 路径经过 {len(path)} 个节点)")
                        else:
                            print(f"  ├─ 二级集合点 {gathering_point}: 不可达")
                except Exception as e:
                    print(f"  ❌ 计算失败: {e}")

        # 显示完整的距离矩阵和分析
        self.display_complete_distance_analysis()

