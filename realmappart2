        for i, (centroid_id, centroid_geom) in enumerate(self.region_centroid_nodes):
            print(f"\n需求点 {i + 1} (Node ID: {centroid_id})")
            print(f"坐标: ({centroid_geom.x:.1f}, {centroid_geom.y:.1f})")

            # 输入低能人群需求量
            while True:
                try:
                    vulnerable_str = input(f"请输入需求点 {i + 1} 的【低能人群】需求量（正整数）: ")
                    vulnerable = int(vulnerable_str)
                    if vulnerable >= 0:  # 允许为0
                        self.vulnerable_demand[centroid_id] = vulnerable
                        print(f"  ✓ 低能人群需求量: {vulnerable}")
                        break
                    else:
                        print("错误：需求量必须为非负整数")
                except ValueError:
                    print("错误：请输入有效的整数")

            # 输入健全人群需求量
            while True:
                try:
                    able_str = input(f"请输入需求点 {i + 1} 的【健全人群】需求量（正整数）: ")
                    able = int(able_str)
                    if able >= 0:  # 允许为0
                        self.able_bodied_demand[centroid_id] = able
                        print(f"  ✓ 健全人群需求量: {able}")
                        break
                    else:
                        print("错误：需求量必须为非负整数")
                except ValueError:
                    print("错误：请输入有效的整数")

            # 显示该需求点的总计
            total = vulnerable + able
            print(f"  → 需求点 {i + 1} 总需求量: {total} (低能: {vulnerable}, 健全: {able})")

        # 显示所有需求点的汇总
        print(f"\n" + "=" * 60)
        print("所有需求点的需求量设置完成")
        print("=" * 60)

        total_vulnerable = 0
        total_able = 0

        for i, (centroid_id, _) in enumerate(self.region_centroid_nodes):
            vuln = self.vulnerable_demand.get(centroid_id, 0)
            able = self.able_bodied_demand.get(centroid_id, 0)
            total = vuln + able

            print(f"需求点 {i + 1} (Node {centroid_id}):")
            print(f"  ├─ 低能人群: {vuln}")
            print(f"  ├─ 健全人群: {able}")
            print(f"  └─ 总计: {total}")

            total_vulnerable += vuln
            total_able += able

        print(f"\n总需求量汇总:")
        print(f"  ├─ 总低能人群: {total_vulnerable}")
        print(f"  ├─ 总健全人群: {total_able}")
        print(f"  └─ 总计: {total_vulnerable + total_able}")
