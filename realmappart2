            self.fig.canvas.draw_idle()

    def select_node(self, event):  # 点击节点 → 红色高亮，再点一次取消
        self.save_history()
        x, y = event.xdata, event.ydata
        click_point = Point(x, y)
        min_dist = float('inf')
        nearest_node = None
        for node_id, node_data in self.nodes.iterrows():
            node_geom = node_data.geometry
            dist = node_geom.distance(click_point)
            if dist < min_dist:
                min_dist = dist
                nearest_node = node_id
        if nearest_node is not None and min_dist < 100:
            if nearest_node in self.selected_nodes:
                self.selected_nodes.remove(nearest_node)
                print(f"Node canceled: {nearest_node}")
            else:
                self.selected_nodes.add(nearest_node)
                print(f"Node Selected: {nearest_node}")
            self.draw_map()

    def select_primary_gathering_point(self, event):
        self.save_history()
        x, y = event.xdata, event.ydata

        shelter = self._find_nearest_shelter(x, y, threshold=80)
        if shelter is None:
            print("提示：请点击避难所点（Primary GP 模式下不允许直接点任意节点）")
            return

        nearest_node = int(shelter["nearest_node"])

        if nearest_node in self.primary_gathering_points:
            self.primary_gathering_points.remove(nearest_node)
            self.primary_capacities.pop(nearest_node, None)
            print(f"取消选择一级集合点(避难所映射节点): {nearest_node}")
        else:
            if nearest_node in self.secondary_gathering_points:
                print(f"错误：节点 {nearest_node} 已是二级集合点，不能同时是两种集合点")
                return

            self.primary_gathering_points.add(nearest_node)
            self.selected_nodes.add(nearest_node)

            try:
                capacity = int(input(f"请输入一级集合点 {nearest_node} 的容量: "))
                if capacity > 0:
                    self.primary_capacities[nearest_node] = capacity
                    print(f"一级集合点已选择: {nearest_node}, 容量: {capacity}")
                else:
                    print("错误：容量必须为正整数")
            except Exception as e:
                print(f"输入错误: {e}")

        self.draw_map()

