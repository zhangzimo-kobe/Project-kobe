    def draw_map(self, preserve_view=True):
        if preserve_view:
            try:
                xlim = self.ax.get_xlim()
                ylim = self.ax.get_ylim()
            except Exception:
                xlim = ylim = None
        else:
            xlim = ylim = None
        self.ax.clear()
        edges = self.edges.copy()
        edge_colors = ['grey'] * len(edges)  # 默认未选择道路为灰线
        edge_widths = [1] * len(edges)
        for i, (u, v, k) in enumerate(edges.index):  # 黑线干路，蓝线小路
            if (u, v, k) in self.selected_edges:
                if (u, v, k) in self.arterial_edges:
                    edge_colors[i] = 'black'
                    edge_widths[i] = 4
                else:
                    edge_colors[i] = 'blue'
                    edge_widths[i] = 3
        edges.plot(ax=self.ax, color=edge_colors, linewidth=edge_widths, alpha=0.7)
        node_colors = ['lightgrey'] * len(self.nodes)
        node_sizes = [30] * len(self.nodes)
        for i, node_id in enumerate(self.nodes.index):
            if node_id in self.primary_gathering_points:
                node_colors[i] = 'darkgreen'  # 一级集合点用深绿色
                node_sizes[i] = 150
            elif node_id in self.secondary_gathering_points:
                node_colors[i] = 'lightgreen'  # 二级集合点用浅绿色
                node_sizes[i] = 120
            elif node_id in self.selected_nodes:
                node_colors[i] = 'red'
                node_sizes[i] = 100

        self.nodes.plot(ax=self.ax, color=node_colors, markersize=node_sizes, alpha=0.8)
        self.draw_disaster_layers()
        plt.suptitle(self.location_name, fontsize=16, y=0.98)
        # 模式提示标语
        if self.mode == 'nodes':
            subtitle = 'Selection Mode: Nodes - Click on intersections'
            self.btn_toggle.label.set_text('Road Selection')
            self.btn_arterial.label.set_text('MainRoad Selection')
        elif self.mode == 'edges':
            subtitle = 'Selection Mode: Roads - Click two nodes to select shortest path between them'
            self.btn_toggle.label.set_text('Node Selection')
            self.btn_arterial.label.set_text('MainRoad Selection')
        elif self.mode == 'arterial':
            subtitle = 'Selection Mode: Arterial Roads - Click on roads to mark/unmark as arterial'
            self.btn_toggle.label.set_text('Node Selection')
            self.btn_arterial.label.set_text('Road Selection')
        elif self.mode == 'primary_gathering':
            subtitle = 'Selection Mode: Primary Gathering Points - Click nodes to mark as primary GP'
            self.btn_toggle.label.set_text('Node Selection')
            self.btn_arterial.label.set_text('MainRoad Selection')
        elif self.mode == 'secondary_gathering':
            subtitle = 'Selection Mode: Secondary Gathering Points - Click nodes to mark as secondary GP'
            self.btn_toggle.label.set_text('Node Selection')
            self.btn_arterial.label.set_text('MainRoad Selection')
        plt.title(subtitle, fontsize=12)
        self.ax.set_xlabel('Longitude')
        self.ax.set_ylabel('Latitude')
        for node_id in self.primary_gathering_points:
            if node_id in self.primary_capacities:
                node_geom = self.nodes.loc[node_id].geometry
                cap = self.primary_capacities[node_id]
                self.ax.text(node_geom.x + 10, node_geom.y + 10, f"P1-Cap: {cap}",
                             fontsize=10, color='darkgreen', ha='left', va='bottom',
                             bbox=dict(facecolor='white', alpha=0.7, edgecolor='darkgreen', boxstyle='round,pad=0.2'))

        for node_id in self.secondary_gathering_points:
            if node_id in self.secondary_capacities:
                node_geom = self.nodes.loc[node_id].geometry
                cap = self.secondary_capacities[node_id]
                self.ax.text(node_geom.x + 10, node_geom.y - 10, f"P2-Cap: {cap}",
                             fontsize=10, color='green', ha='left', va='top',
                             bbox=dict(facecolor='white', alpha=0.7, edgecolor='green', boxstyle='round,pad=0.2'))

        if not hasattr(self, '_init_view') or self._init_view is None:
            self._init_view = (self.ax.get_xlim(), self.ax.get_ylim())
        if preserve_view and xlim and ylim:
            self.ax.set_xlim(xlim)
            self.ax.set_ylim(ylim)
        elif not preserve_view and hasattr(self, '_init_view') and self._init_view is not None:
            self.ax.set_xlim(self._init_view[0])
            self.ax.set_ylim(self._init_view[1])

        self.fig.canvas.draw_idle()  # 更新画布

    def draw_disaster_layers(self):
        """在地图上绘制灾害图层"""
        disaster_colors = {
            'Tsunami': 'red',
            'Landslide': 'brown',
            'Flood': 'cyan'
        }

        disaster_alphas = {
            'Tsunami': 0.5,  # 透明度
            'Landslide': 0.3,
            'Flood': 0.25
        }

        disaster_edge_colors = {
            'Tsunami': 'darkred',  # 边框颜色
            'Landslide': 'darkred',
            'Flood': 'darkblue'
        }

        disaster_edge_widths = {
            'Tsunami': 0.5,  # 边框宽度
            'Landslide': 1.5,
            'Flood': 1.0
        }

        for disaster_type in ['Tsunami', 'Landslide', 'Flood']:
            if self.disaster_visible[disaster_type] and self.disaster_data.get(disaster_type) is not None:
                gdf = self.disaster_data[disaster_type]
                color = disaster_colors[disaster_type]
                alpha = disaster_alphas[disaster_type]
                edge_color = disaster_edge_colors[disaster_type]
                edge_width = disaster_edge_widths[disaster_type]

                # 绘制灾害区域
                gdf.plot(
                    ax=self.ax,
                    color=color,
                    alpha=alpha,
                    edgecolor=edge_color,
                    linewidth=edge_width,
                    zorder=10  # 确保在最上层显示
                )

                print(f"✓ 绘制 {disaster_type} 图层: {len(gdf)} 个区域")

    def connect_events(self):
        self.cid_click = self.fig.canvas.mpl_connect('button_press_event', self.on_click)

    def on_click(self, event):
        if event.inaxes != self.ax:
            return
        if self.mode == 'nodes':
            self.select_node(event)
        elif self.mode == 'edges':
            self.select_edge(event)
        elif self.mode == 'arterial':
            self.select_arterial(event)
        elif self.mode == 'primary_gathering':
            self.select_primary_gathering_point(event)
        elif self.mode == 'secondary_gathering':
            self.select_secondary_gathering_point(event)

    def toggle_mode(self, event):  # 在节点模式和道路选择模式中切换
        if self.mode == 'nodes':
            self.mode = 'edges'
            self.btn_toggle.label.set_text('Switch to Node Selection')
        else:
            self.mode = 'nodes'
            self.btn_toggle.label.set_text('Switch to Road Selection')
        self.temp_edge = []
        self.draw_map()

    def toggle_arterial(self, event):  # 在干路模式和普通道路模式中切换
        if self.mode == 'arterial':
            self.mode = 'edges'
            self.btn_arterial.label.set_text('Switch to Arterial Selection')
        else:
            self.mode = 'arterial'
            self.btn_arterial.label.set_text('Switch to Road Selection')
        self.temp_edge = []
        self.draw_map()

    def toggle_primary_gathering(self, event):
        """切换到一级集合点选择模式"""
        if self.mode == 'primary_gathering':
            self.mode = 'edges'
            self.btn_primary_gp.label.set_text('Primary GP')
        else:
            self.mode = 'primary_gathering'
            self.btn_primary_gp.label.set_text('Switch to Road')
        self.temp_edge = []
        self.draw_map()

    def toggle_secondary_gathering(self, event):
        """切换到二级集合点选择模式"""
        if self.mode == 'secondary_gathering':
            self.mode = 'edges'
            self.btn_secondary_gp.label.set_text('Secondary GP')
        else:
            self.mode = 'secondary_gathering'
            self.btn_secondary_gp.label.set_text('Switch to Road')
        self.temp_edge = []
        self.draw_map()

    def toggle_tsunami(self, event):
        """切换海啸灾害显示"""
        self.disaster_visible['Tsunami'] = not self.disaster_visible['Tsunami']
        status = "显示" if self.disaster_visible['Tsunami'] else "隐藏"
        print(f"海啸灾害图层: {status}")
        self.draw_map()

    def toggle_landslide(self, event):
        """切换山体滑坡灾害显示"""
        self.disaster_visible['Landslide'] = not self.disaster_visible['Landslide']
        status = "显示" if self.disaster_visible['Landslide'] else "隐藏"
        print(f"山体滑坡灾害图层: {status}")
        self.draw_map()

    def toggle_flood(self, event):
        """切换洪水灾害显示"""
        self.disaster_visible['Flood'] = not self.disaster_visible['Flood']
        status = "显示" if self.disaster_visible['Flood'] else "隐藏"
        print(f"洪水灾害图层: {status}")
        self.draw_map()

    def zoom_in(self, event):
        xlim = self.ax.get_xlim()
        ylim = self.ax.get_ylim()
        xmid = (xlim[0] + xlim[1]) / 2
        ymid = (ylim[0] + ylim[1]) / 2
        scale = 0.5
        xdelta = (xlim[1] - xlim[0]) * scale / 2
        ydelta = (ylim[1] - ylim[0]) * scale / 2
        self.ax.set_xlim([xmid - xdelta, xmid + xdelta])
        self.ax.set_ylim([ymid - ydelta, ymid + ydelta])
        self.fig.canvas.draw_idle()

    def zoom_out(self, event):
        xlim = self.ax.get_xlim()
        ylim = self.ax.get_ylim()
        xmid = (xlim[0] + xlim[1]) / 2
        ymid = (ylim[0] + ylim[1]) / 2
        scale = 2.0
        xdelta = (xlim[1] - xlim[0]) * scale / 2
        ydelta = (ylim[1] - ylim[0]) * scale / 2
        self.ax.set_xlim([xmid - xdelta, xmid + xdelta])
        self.ax.set_ylim([ymid - ydelta, ymid + ydelta])
        self.fig.canvas.draw_idle()

    def zoom_reset(self, event):
        if hasattr(self, '_init_view') and self._init_view is not None:
            self.ax.set_xlim(self._init_view[0])
            self.ax.set_ylim(self._init_view[1])
            self.fig.canvas.draw_idle()

    def select_node(self, event):  # 点击节点 → 红色高亮，再点一次取消
        self.save_history()
        x, y = event.xdata, event.ydata
        click_point = Point(x, y)
        min_dist = float('inf')
        nearest_node = None
        for node_id, node_data in self.nodes.iterrows():
            node_geom = node_data.geometry
            dist = node_geom.distance(click_point)
            if dist < min_dist:
                min_dist = dist
                nearest_node = node_id
        if nearest_node is not None and min_dist < 100:
            if nearest_node in self.selected_nodes:
                self.selected_nodes.remove(nearest_node)
                print(f"Node canceled: {nearest_node}")
            else:
                self.selected_nodes.add(nearest_node)
                print(f"Node Selected: {nearest_node}")
            self.draw_map()

    def select_primary_gathering_point(self, event):
        """选择一级集合点"""
        self.save_history()
        x, y = event.xdata, event.ydata
