class RoadNetworkSelector:
    def __init__(self, location, dist=1000, location_name=""):
        self.location_name = location_name if location_name else "Selected Area"
        self.G = ox.graph_from_point(location, dist=dist, network_type='drive')
        self.G = ox.project_graph(self.G)
        self.nodes, self.edges = ox.graph_to_gdfs(self.G)
        self.original_G = self.G.copy()
        self.selected_G = nx.MultiDiGraph()
        for key, value in self.original_G.graph.items():
            self.selected_G.graph[key] = value
        self.selected_nodes = set()
        self.crossing_matrix = None
        self.selected_edges = set()
        self.arterial_edges = set()
        self.gathering_points = set()
        self.gathering_point_capacities = dict()
        self.demand_quantities = {}  # 存储各需求点的疏散需求量
        self.region_centroid_nodes = []  # 存储小区形心节点（需求点）
        self.distance_matrix = None  # 完整距离矩阵：形心 × 集合点
        self.shortest_paths = {}  # 存储所有最短路径
        self.crossing_graph = None  # 穿越次数连通图
        self.crossing_matrix = None  # 穿越次数矩阵
        self.mode = 'nodes'
        self.selecting = False
        self.temp_edge = []
        self._history = []  # 撤销历史栈
        self.disaster_data = {}  # 存储灾害数据
        self.disaster_visible = {
            'Tsunami': False,
            'Landslide': False,
            'Flood': False
        }
        self.load_disaster_data()  # 加载灾害数据
        self.fig, self.ax = plt.subplots(figsize=(12, 10))
        plt.subplots_adjust(left=0.12, right=0.88, bottom=0.15, top=0.9)
        self._init_view = None
        self.add_buttons()
        self.draw_map(preserve_view=False)
        self.connect_events()
        plt.show()

    def load_disaster_data(self):
        """从data/目录加载灾害文件（支持GeoJSON和Shapefile）"""
        disaster_files = {
            'Tsunami': [
                'data/A40-16_28.shp',  # Shapefile 格式
            ],
            'Landslide': [
                'data/Landslide.geojson',
            ],
            'Flood': [
                'data/Flood.geojson',
            ]
        }

        # 等待路网数据加载完成
        if not hasattr(self, 'nodes') or self.nodes is None:
            print("警告: 路网数据尚未加载")
            for disaster_type in disaster_files.keys():
                self.disaster_data[disaster_type] = None
            return

        print(f"\n路网坐标系: {self.nodes.crs}")
        print(f"路网边界范围: {self.nodes.total_bounds}")

        for disaster_type, filepaths in disaster_files.items():
            gdf = None
            loaded_file = None

            # 尝试按顺序加载不同格式的文件
            for filepath in filepaths:
                try:
                    print(f"\n尝试加载: {filepath}")

                    if filepath.endswith('.shp'):
                        # 加载 Shapefile（使用 shift-jis 编码）
                        gdf = gpd.read_file(filepath, encoding='shift-jis')
                        print(f"  ✓ 成功读取 {len(gdf)} 个要素")

                        # 显示信息
                        print(f"  几何类型: {list(gdf.geometry.type.unique())}")
                        print(f"  属性字段: {list(gdf.columns)}")

                        # 修复无效几何
                        invalid_count = (~gdf.geometry.is_valid).sum()
                        if invalid_count > 0:
                            print(f"  修复 {invalid_count} 个无效几何...")
                            gdf['geometry'] = gdf.geometry.buffer(0)

                    elif filepath.endswith('.geojson'):
                        gdf = gpd.read_file(filepath)

                    if gdf is not None and len(gdf) > 0:
                        loaded_file = filepath
                        print(f"✓ 成功从 {filepath} 加载数据")
                        break

                except FileNotFoundError:
                    print(f"  文件不存在: {filepath}")
                    continue
                except Exception as e:
                    print(f"  加载失败: {e}")
                    continue

            # 如果成功加载了数据
            if gdf is not None and len(gdf) > 0:
                print(f"\n--- {disaster_type} 文件信息 ---")
                print(f"加载的文件: {loaded_file}")
                print(f"原始坐标系: {gdf.crs}")
                print(f"要素数量: {len(gdf)}")
                print(f"原始边界范围: {gdf.total_bounds}")

                # 设置坐标系
                if not gdf.crs:
                    print(f"警告: {disaster_type} 文件没有坐标系统信息，假定为 EPSG:4326")
                    gdf = gdf.set_crs("EPSG:4326", allow_override=True)

                # 转换到与路网相同的投影坐标系
                if gdf.crs != self.nodes.crs:
                    print(f"转换坐标系: {gdf.crs} → {self.nodes.crs}")
                    gdf = gdf.to_crs(self.nodes.crs)
                    print(f"转换后边界范围: {gdf.total_bounds}")

                # 检查是否与路网范围重叠
                nodes_bounds = self.nodes.total_bounds
                disaster_bounds = gdf.total_bounds

                overlap_x = not (disaster_bounds[2] < nodes_bounds[0] or disaster_bounds[0] > nodes_bounds[2])
                overlap_y = not (disaster_bounds[3] < nodes_bounds[1] or disaster_bounds[1] > nodes_bounds[3])

                if overlap_x and overlap_y:
                    print(f"✓ {disaster_type} 数据与路网范围有重叠")

                    # 裁剪到路网范围（添加缓冲区）
                    from shapely.geometry import box
                    buffer = 1000  # 1公里缓冲区

                    clip_box = box(
                        nodes_bounds[0] - buffer,
                        nodes_bounds[1] - buffer,
                        nodes_bounds[2] + buffer,
                        nodes_bounds[3] + buffer
                    )

                    original_count = len(gdf)
                    gdf = gdf[gdf.intersects(clip_box)].copy()

                    if len(gdf) < original_count:
                        print(f"  裁剪到研究区域: {original_count} → {len(gdf)} 个要素")

                else:
                    print(f"⚠ 警告: {disaster_type} 数据与路网范围不重叠")
                    print(
                        f"   路网范围: X[{nodes_bounds[0]:.0f}, {nodes_bounds[2]:.0f}], Y[{nodes_bounds[1]:.0f}, {nodes_bounds[3]:.0f}]")
                    print(
                        f"   灾害范围: X[{disaster_bounds[0]:.0f}, {disaster_bounds[2]:.0f}], Y[{disaster_bounds[1]:.0f}, {disaster_bounds[3]:.0f}]")
                    print(f"   建议增大路网的 dist 参数")

                self.disaster_data[disaster_type] = gdf
                print(f"✓ 成功加载 {disaster_type} 数据")
            else:
                print(f"✗ 未能加载 {disaster_type} 数据")
                self.disaster_data[disaster_type] = None

