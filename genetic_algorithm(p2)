                ax2.scatter(geom.x, geom.y, c='darkgreen', s=150, marker='s', zorder=5)
                ax2.annotate(f'P1-{j + 1}', (geom.x, geom.y), fontsize=8, xytext=(5, 5), textcoords='offset points')

        # 绘制二级集合点
        for j, node_id in enumerate(self.secondary_gp_nodes):
            if node_id in nodes_gdf.index:
                geom = nodes_gdf.loc[node_id].geometry
                ax2.scatter(geom.x, geom.y, c='lightgreen', s=120, marker='^', zorder=5)
                ax2.annotate(f'P2-{j + 1}', (geom.x, geom.y), fontsize=8, xytext=(5, 5), textcoords='offset points')

        # 绘制分配连线
        vulnerable_assignment = best_solution['vulnerable_assignment']
        able_assignment = best_solution['able_assignment']

        for i, node_id in enumerate(self.demand_nodes):
            if node_id not in nodes_gdf.index:
                continue
            demand_geom = nodes_gdf.loc[node_id].geometry

            # 低能人群分配线（红色虚线）
            j = vulnerable_assignment[i]
            if j != -1 and self.vulnerable_demands[i] > 0:
                gp_node = self.primary_gp_nodes[j]
                if gp_node in nodes_gdf.index:
                    gp_geom = nodes_gdf.loc[gp_node].geometry
                    ax2.plot([demand_geom.x, gp_geom.x], [demand_geom.y, gp_geom.y],
                             'r--', alpha=0.6, linewidth=1.5)

            # 健全人群分配线（蓝色或紫色实线）
            assign = able_assignment[i]
            if assign is not None and self.able_demands[i] > 0:
                gp_type, j_able = assign
                if gp_type == 'primary':
                    gp_node = self.primary_gp_nodes[j_able]
                    color = 'blue'
                else:
                    gp_node = self.secondary_gp_nodes[j_able]
                    color = 'purple'
                if gp_node in nodes_gdf.index:
                    gp_geom = nodes_gdf.loc[gp_node].geometry
                    ax2.plot([demand_geom.x, gp_geom.x], [demand_geom.y, gp_geom.y],
                             c=color, alpha=0.5, linewidth=1)

        ax2.set_title(f'最佳分配方案\n加权距离: {best_solution["objectives"][0]:.1f}, '
                      f'加权穿越: {best_solution["objectives"][1]:. 1f}', fontsize=12)

        # 添加图例
        legend_elements = [
        Line2D([0], [0], color='red', linestyle='--', linewidth=1.5, label = '低能人群→一级'),
        Line2D([0], [0], color='blue', linestyle='-', linewidth=1, label='健全人群→一级'),
        Line2D([0], [0], color='purple', linestyle='-', linewidth=1, label='健全人群→二级'),
        Line2D([0], [0], marker='o', color='w', markerfacecolor='red', markersize=8, label='需求点'),
        Line2D([0], [0], marker='s', color='w', markerfacecolor='darkgreen', markersize=10, label='一级集合点'),
        Line2D([0], [0], marker='^', color='w', markerfacecolor='lightgreen', markersize=10, label='二级集合点'),
        ]
        ax2.legend(handles=legend_elements, loc='upper right', fontsize=8)

        # ========== 子图3：收敛曲线 - 距离 ==========
        ax3 = axes[1, 0]
        ax3.plot(self.history['generation'], self.history['best_obj1'], 'b-', linewidth=2)
        ax3.set_xlabel('迭代次数', fontsize=12)
        ax3.set_ylabel('最佳加权距离 (人·米)', fontsize=12)
        ax3.set_title('收敛曲线 - 步行距离', fontsize=14)
        ax3.grid(True, alpha=0.3)

        # ========== 子图4：收敛曲线 - 穿越次数 ==========
        ax4 = axes[1, 1]
        ax4.plot(self.history['generation'], self.history['best_obj2'], 'r-', linewidth=2)
        ax4.set_xlabel('迭代次数', fontsize=12)
        ax4.set_ylabel('最佳加权穿越次数 (人·次)', fontsize=12)
        ax4.set_title('收敛曲线 - 穿越次数', fontsize=14)
        ax4.grid(True, alpha=0.3)

        plt.tight_layout()
        plt.savefig('nsga2_results.png', dpi=150, bbox_inches='tight')
        print(f"\n✓ 优化结果图已保存为 'nsga2_results. png'")
        plt.show()

    def export_results(self, filename: str = "pareto_solutions.csv"):
        """导出帕累托最优解到CSV文件"""
        if not self.pareto_front:
            print("没有找到可行解")
            return

        results = []
        for idx, solution in enumerate(self.pareto_front):
            vulnerable_assignment = solution['vulnerable_assignment']
            able_assignment = solution['able_assignment']
            obj1, obj2 = solution['objectives']

            # 计算低能人群分配统计
            vulnerable_allocated = np.sum(vulnerable_assignment != -1)
            total_vulnerable_demand = np.sum(self.vulnerable_demands[vulnerable_assignment != -1])

            # 计算健全人群分配统计
            able_allocated = 0
            total_able_demand = 0
            for i in range(self.num_demands):
                if able_assignment[i] is not None:
                    able_allocated += 1
                    total_able_demand += self.able_demands[i]

            # 计算一级集合点利用率
            primary_utilization = []
            for j in range(self.num_primary_gp):
                # 低能人群负载
                vuln_load = np.sum(self.vulnerable_demands[vulnerable_assignment == j])
                # 健全人群负载
                able_load = 0
                for i in range(self.num_demands):
                    assign = able_assignment[i]
                    if assign is not None and assign[0] == 'primary' and assign[1] == j:
                        able_load += self.able_demands[i]
                total_load = vuln_load + able_load
                util_rate = total_load / self.primary_capacities[j] if self.primary_capacities[j] > 0 else 0
                primary_utilization.append(util_rate)

            # 计算二级集合点利用率
            secondary_utilization = []
            for j in range(self.num_secondary_gp):
                able_load = 0
                for i in range(self.num_demands):
                    assign = able_assignment[i]
                    if assign is not None and assign[0] == 'secondary' and assign[1] == j:
                        able_load += self.able_demands[i]
                util_rate = able_load / self.secondary_capacities[j] if self.secondary_capacities[j] > 0 else 0
                secondary_utilization.append(util_rate)

            avg_primary_util = np.mean(primary_utilization) if primary_utilization else 0
            avg_secondary_util = np.mean(secondary_utilization) if secondary_utilization else 0

            # 将 able_assignment 转换为可序列化格式
            able_assignment_serialized = []
            for assign in able_assignment:
                if assign is None:
                    able_assignment_serialized.append(None)
                else:
                    able_assignment_serialized.append(f"{assign[0]}_{assign[1]}")

            results.append({
                'solution_id': idx + 1,
                'weighted_total_distance': obj1,
                'weighted_total_crossings': obj2,
                'vulnerable_allocated': vulnerable_allocated,
                'able_allocated': able_allocated,
                'total_vulnerable_demand': total_vulnerable_demand,
                'total_able_demand': total_able_demand,
                'avg_primary_utilization': avg_primary_util,
                'avg_secondary_utilization': avg_secondary_util,
                'vulnerable_assignment': vulnerable_assignment.tolist(),
                'able_assignment': able_assignment_serialized
            })

        df = pd.DataFrame(results)
        df.to_csv(filename, index=False, encoding='utf-8-sig')
        print(f"帕累托最优解已导出到 {filename}")


def run_optimization(road_network_selector,
                     terrain_type='flat',  # 在这里调整地形类别：flat/hilly/mountainous
                     elevation_factor=1.0,  # 在这里微调地形参数
                     road_condition_factor=1.0,  # 在这里微调道路参数
                     vulnerable_weight=2.0,  # 低能人群权重（默认2.0，表示低能人群的距离和穿越成本是健全人群的2倍）
                     population_size=100,  # 种群大小
                     max_generations=200):  # 最大迭代次数
    """
    运行优化算法的主函数

    Args:
        road_network_selector: RoadNetworkSelector实例
        terrain_type: 地形类型 ('flat'=平原, 'hilly'=丘陵, 'mountainous'=山区)
        elevation_factor: 海拔影响因子 (0. 5-2.0, 值越小距离限制越严格)
        road_condition_factor: 路况影响因子 (0.5-2.0, 值越小距离限制越严格)
        vulnerable_weight: 低能人群权重 (>=1.0, 值越大越优先考虑低能人群)
        population_size: 种群大小
        max_generations: 最大迭代次数
    """
    try:
        # 创建遗传算法实例
        ga = MultiObjectiveGA(
            road_network=road_network_selector,
            population_size=population_size,
            max_generations=max_generations,
            crossover_rate=0.8,
            mutation_rate=0.1,
            terrain_type=terrain_type,
            elevation_factor=elevation_factor,
            road_condition_factor=road_condition_factor,
            vulnerable_weight=vulnerable_weight
        )

        # 运行算法
        pareto_solutions = ga.run()
        if pareto_solutions and len(pareto_solutions) > 0:
            try:
                ga.visualize_results()
            except Exception as e:
                print(f"可视化时出现警告: {e}")

            # 导出结果
            try:
                ga.export_results()
            except Exception as e:
                print(f"导出结果时出现警告: {e}")

        return ga, pareto_solutions

    except Exception as e:
        print(f"优化过程中出现错误: {e}")
        import traceback
        traceback.print_exc()
        return None, None

