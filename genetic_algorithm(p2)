        def _repair_individual(self, individual: Dict) -> Dict:
        """
        修复不可行个体（重点修复容量约束；距离约束在生成/变异时已筛过）
        修复策略：
          1) 一级超载：优先移动健全人群（P1->P2 或 P1->其他P1）
          2) 若一级仍超载：再移动低能人群（只能 P1->其他P1）
          3) 二级超载：移动健全人群（P2->P1 或 P2->其他P2）
        """
        repaired = self._copy_individual(individual)

        # ---------- 计算当前负载 ----------
        primary_load = np.zeros(self.num_primary_gp, dtype=float)
        secondary_load = np.zeros(self.num_secondary_gp, dtype=float) if self.num_secondary_gp > 0 else np.array([])

        # 低能负载（只在一级）
        for i in range(self.num_demands):
            j = repaired['vulnerable_assignment'][i]
            if j != -1 and self.vulnerable_demands[i] > 0:
                primary_load[j] += self.vulnerable_demands[i]

        # 健全负载
        for i in range(self.num_demands):
            assign = repaired['able_assignment'][i]
            if assign is None or self.able_demands[i] <= 0:
                continue
            gp_type, j = assign
            if gp_type == 'primary':
                primary_load[j] += self.able_demands[i]
            else:
                if self.num_secondary_gp > 0:
                    secondary_load[j] += self.able_demands[i]

        # 为避免死循环：每个集合点最多尝试移动若干次
        max_moves_per_gp = self.num_demands * 2

        # ---------- 工具函数：检查某个需求点 i 能否把健全人群移到指定点 ----------
        def can_move_able_to_primary(i: int, k: int) -> bool:
            return (self.primary_distance_matrix[i, k] <= self.dmax_able and
                    primary_load[k] + self.able_demands[i] <= self.primary_capacities[k])

        def can_move_able_to_secondary(i: int, k: int) -> bool:
            if self.num_secondary_gp <= 0:
                return False
            return (self.secondary_distance_matrix[i, k] <= self.dmax_able and
                    secondary_load[k] + self.able_demands[i] <= self.secondary_capacities[k])

        # ---------- 工具函数：检查某个需求点 i 能否把低能人群移到指定一级点 ----------
        def can_move_vuln_to_primary(i: int, k: int) -> bool:
            return (self.primary_distance_matrix[i, k] <= self.dmax_able and
                    primary_load[k] + self.vulnerable_demands[i] <= self.primary_capacities[k])

        # 1) 修复一级集合点超容量
        for j in range(self.num_primary_gp):
            moves = 0
            while primary_load[j] > self.primary_capacities[j] and moves < max_moves_per_gp:
                moved = False

                # (1) 优先移动“健全人群（当前在该一级点）”
                for i in range(self.num_demands):
                    assign = repaired['able_assignment'][i]
                    if (assign is None) or (self.able_demands[i] <= 0):
                        continue
                    if assign[0] != 'primary' or assign[1] != j:
                        continue

                    able_demand = self.able_demands[i]

                    # 1.1 尝试 P1(j) -> P2(k)
                    if self.num_secondary_gp > 0:
                        for k in range(self.num_secondary_gp):
                            if can_move_able_to_secondary(i, k):
                                repaired['able_assignment'][i] = ('secondary', k)
                                primary_load[j] -= able_demand
                                secondary_load[k] += able_demand
                                moved = True
                                break
                        if moved:
                            break

                    # 1.2 尝试 P1(j) -> P1(k)
                    for k in range(self.num_primary_gp):
                        if k == j:
                            continue
                        if can_move_able_to_primary(i, k):
                            repaired['able_assignment'][i] = ('primary', k)
                            primary_load[j] -= able_demand
                            primary_load[k] += able_demand
                            moved = True
                            break

                    if moved:
                        break

                if moved:
                    moves += 1
                    continue

                # 若健全人群无法再移动，尝试移动“低能人群（当前在该一级点）”
                for i in range(self.num_demands):
                    cur_j = repaired['vulnerable_assignment'][i]
                    if cur_j != j or self.vulnerable_demands[i] <= 0:
                        continue

                    vuln_demand = self.vulnerable_demands[i]

                    # 尝试 P1(j) -> P1(k)
                    feasible_targets = []
                    for k in range(self.num_primary_gp):
                        if k == j:
                            continue
                        if can_move_vuln_to_primary(i, k):
                            feasible_targets.append(k)

                    if feasible_targets:
                        # 这里可随机，也可选最近。给你选最近更稳：
                        best_k = min(feasible_targets, key=lambda k: self.primary_distance_matrix[i, k])
                        repaired['vulnerable_assignment'][i] = best_k
                        primary_load[j] -= vuln_demand
                        primary_load[best_k] += vuln_demand
                        moved = True
                        break

                if not moved:
                    # 实在修不动（可能整体不可行或距离限制太严）
                    break

                moves += 1

        # 2) 修复二级集合点超容量
        if self.num_secondary_gp > 0:
            for j in range(self.num_secondary_gp):
                moves = 0
                while secondary_load[j] > self.secondary_capacities[j] and moves < max_moves_per_gp:
                    moved = False

                    for i in range(self.num_demands):
                        assign = repaired['able_assignment'][i]
                        if (assign is None) or (self.able_demands[i] <= 0):
                            continue
                        if assign[0] != 'secondary' or assign[1] != j:
                            continue

                        able_demand = self.able_demands[i]

                        # 2.1 尝试 P2(j) -> P1(k)
                        for k in range(self.num_primary_gp):
                            if can_move_able_to_primary(i, k):
                                repaired['able_assignment'][i] = ('primary', k)
                                secondary_load[j] -= able_demand
                                primary_load[k] += able_demand
                                moved = True
                                break
                        if moved:
                            break

                        # 2.2 尝试 P2(j) -> P2(k)
                        for k in range(self.num_secondary_gp):
                            if k == j:
                                continue
                            if can_move_able_to_secondary(i, k):
                                repaired['able_assignment'][i] = ('secondary', k)
                                secondary_load[j] -= able_demand
                                secondary_load[k] += able_demand
                                moved = True
                                break

                        if moved:
                            break

                    if not moved:
                        break

                    moves += 1

        # 这里用你已有的可行性检查函数（如果你希望更严格，可以改成不可行就抛错/重生成）
        if hasattr(self, "_is_feasible_assignment"):
            if not self._is_feasible_assignment(repaired):
                # 保守策略：直接返回（让后续选择淘汰它）
                # 更激进策略：raise ValueError 或者 return self._generate_random_individual()
                return repaired

        return repaired

    def _copy_individual(self, individual: Dict) -> Dict:
        """复制个体（深拷贝版，避免引用共享）"""
        return {
            'vulnerable_assignment': individual['vulnerable_assignment'].copy(),
            'able_assignment': copy.deepcopy(individual['able_assignment'])
        }

    def _environmental_selection(self, fronts: List[List[int]]):
        """环境选择"""
        new_population = []

        for front in fronts:
            if len(new_population) + len(front) <= self.population_size:
                # 整个前沿都可以加入
                new_population.extend(front)
            else:
                # 只能加入部分个体
                remaining_slots = self.population_size - len(new_population)
                self._calculate_crowding_distance(front)

                # 按拥挤度距离降序排序
                front.sort(key=lambda x: self.population[x]['crowding_distance'], reverse=True)
                new_population.extend(front[:remaining_slots])
                break

        # 更新种群
        self.population = [self.population[i] for i in new_population]

    def _update_pareto_front(self):
        """更新帕累托前沿"""
        # 找到第一层前沿
        first_front = []
        for i, individual in enumerate(self.population):
            if individual['rank'] == 0:
                first_front.append(individual)

        self.pareto_front = first_front

    def _record_history(self):
        """记录历史信息"""
        if self.pareto_front:
            objectives = [ind['objectives'] for ind in self.pareto_front]
            obj1_values = [obj[0] for obj in objectives]
            obj2_values = [obj[1] for obj in objectives]

            self.history['best_obj1'].append(min(obj1_values))
            self.history['best_obj2'].append(min(obj2_values))
            self.history['pareto_size'].append(len(self.pareto_front))
        else:
            self.history['best_obj1'].append(float('inf'))
            self.history['best_obj2'].append(float('inf'))
            self.history['pareto_size'].append(0)

        self.history['generation'].append(self.generation)

    def run(self) -> List[Dict]:
        """
        运行遗传算法

        Returns:
            List[Dict]: 帕累托最优解集
        """
        print("\n" + "=" * 60)
        print("开始运行双目标遗传算法")
        print("=" * 60)

        start_time = time.time()

        # 初始化种群
        self._initialize_population()

        for generation in range(self.max_generations):
            self.generation = generation

            # 非支配排序
            fronts = self._fast_non_dominated_sort()

            # 计算拥挤度距离
            for front in fronts:
                self._calculate_crowding_distance(front)

            # 更新帕累托前沿
            self._update_pareto_front()

            # 记录历史
            self._record_history()

            # 输出进度
            if generation % 20 == 0 or generation == self.max_generations - 1:
                print(f"第 {generation + 1} 代: 帕累托前沿大小 = {len(self.pareto_front)}")
                if self.pareto_front:
                    best_dist = min([ind['objectives'][0] for ind in self.pareto_front])
                    best_cross = min([ind['objectives'][1] for ind in self.pareto_front])
                    print(f"  最佳距离: {best_dist:.2f}, 最佳穿越: {best_cross:.2f}")

            # 如果不是最后一代，进行繁殖
            if generation < self.max_generations - 1:
                # 繁殖
                offspring = []
                while len(offspring) < self.population_size:
                    # 选择父代
                    parent1_idx = self._tournament_selection()
                    parent2_idx = self._tournament_selection()

                    parent1 = {
                        'vulnerable_assignment': self.population[parent1_idx]['vulnerable_assignment'],
                        'able_assignment': self.population[parent1_idx]['able_assignment']
                    }
                    parent2 = {
                        'vulnerable_assignment': self.population[parent2_idx]['vulnerable_assignment'],
                        'able_assignment': self.population[parent2_idx]['able_assignment']
                    }

                    # 交叉
                    child1, child2 = self._crossover(parent1, parent2)

                    # 变异
                    child1 = self._mutate(child1)
                    child2 = self._mutate(child2)

                    # 计算目标函数
                    obj1 = self._calculate_objectives(child1)
                    obj2 = self._calculate_objectives(child2)

                    offspring.extend([
                        {
                            'vulnerable_assignment': child1['vulnerable_assignment'],
                            'able_assignment': child1['able_assignment'],
                            'objectives': obj1,
                            'rank': 0,
                            'crowding_distance': 0.0
                        },
                        {
                            'vulnerable_assignment': child2['vulnerable_assignment'],
                            'able_assignment': child2['able_assignment'],
                            'objectives': obj2,
                            'rank': 0,
                            'crowding_distance': 0.0
                        }
                    ])

                # 合并父代和子代
                self.population.extend(offspring[:self.population_size])

                # 非支配排序
                fronts = self._fast_non_dominated_sort()

                # 环境选择
                self._environmental_selection(fronts)

        end_time = time.time()
        runtime = end_time - start_time
        print(f"\nDistance limit base: {self.dmax_base:.1f}m (Terrain type: {self.terrain_type})")
        print(f"Distance limit vulnerable/able: {self.dmax_vulnerable:.1f}m / {self.dmax_able:.1f}m")
        print(f"\n算法运行完成，耗时 {runtime:.2f} 秒")
        print(f"最终帕累托前沿包含 {len(self.pareto_front)} 个解")
        print(f"\n帕累托最优解详情（共 {len(self.pareto_front)} 个解）")
        for idx, solution in enumerate(self.pareto_front):
            vulnerable_assignment = solution['vulnerable_assignment']
            able_assignment = solution['able_assignment']
            obj1, obj2 = solution['objectives']

            print(f"\n【解 {idx + 1}】")
            print(f"  总加权距离: {obj1:.0f} 人·米")
            print(f"  总加权穿越: {obj2:.0f} 人·次")

            # 统计一级集合点使用情况
            primary_load = np.zeros(self.num_primary_gp)
            for i in range(self.num_demands):
                j = vulnerable_assignment[i]
                if j != -1:
                    primary_load[j] += self.vulnerable_demands[i]
                assign = able_assignment[i]
                if assign is not None and assign[0] == 'primary':
                    primary_load[assign[1]] += self.able_demands[i]

            used_primary = [j for j in range(self.num_primary_gp) if primary_load[j] > 0]
            print(f"  使用一级集合点: {len(used_primary)}/{self.num_primary_gp}")
            for j in used_primary:
                utilization = primary_load[j] / self.primary_capacities[j] * 100
                print(
                    f"    一级{j + 1}: {primary_load[j]:.0f}/{self.primary_capacities[j]:.0f}人 ({utilization:.1f}%)")

            # 统计二级集合点使用情况
            if self.num_secondary_gp > 0:
                secondary_load = np.zeros(self.num_secondary_gp)
                for i in range(self.num_demands):
                    assign = able_assignment[i]
                    if assign is not None and assign[0] == 'secondary':
                        secondary_load[assign[1]] += self.able_demands[i]

                used_secondary = [j for j in range(self.num_secondary_gp) if secondary_load[j] > 0]
                print(f"  使用二级集合点: {len(used_secondary)}/{self.num_secondary_gp}")
                for j in used_secondary:
                    utilization = secondary_load[j] / self.secondary_capacities[j] * 100
                    print(
                        f"    二级{j + 1}: {secondary_load[j]:.0f}/{self.secondary_capacities[j]:.0f}人 ({utilization:.1f}%)")

        print(f"\n" + "=" * 60)
        return self.pareto_front

