            for i, assign_info in enumerate(able_assignment):
                if assign_info != -1:
                    gp_type, j = assign_info
                    if gp_type == 'secondary':
                        gathering_node = secondary_list[j]
                        demand_node = self.region_centroid_nodes[i][0]
                        secondary_usage[gathering_node] += self.able_bodied_demand.get(demand_node, 0)

            print("\n二级集合点使用情况:")
            for idx, node in enumerate(secondary_list):
                capacity = self.secondary_capacities.get(node, "未设置")
                able = secondary_usage[node]
