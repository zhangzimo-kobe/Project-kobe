    def calculate_crossing_matrix(self):
        """分别计算需求点到一级和二级集合点的穿越次数矩阵"""

        if not self.region_centroid_nodes:
            print("没有需求点，无法计算穿越次数矩阵")
            return None

        # 获取干路线段
        arterial_lines = []
        for u, v, data in self.G.edges(data=True):
            if data.get('highway') == 'primary' or data.get('highway') == 'trunk':
                edge_geom = data.get('geometry')
                if edge_geom:
                    arterial_lines.append(edge_geom)

        print(f"找到 {len(arterial_lines)} 条干路用于穿越计算")

        num_demand = len(self.region_centroid_nodes)

        # === 计算一级集合点穿越次数矩阵 ===
        if self.primary_gathering_points:
            print("\n计算到一级集合点的穿越次数...")
            num_primary = len(self.primary_gathering_points)
            self.primary_crossing_matrix = np.full((num_demand, num_primary), -1, dtype=int)

            primary_list = list(self.primary_gathering_points)

            for i, demand_item in enumerate(self.region_centroid_nodes):
                demand_point = demand_item[1]  # 获取Point对象

                for j, gathering_node in enumerate(primary_list):
                    try:
                        gathering_point = Point(self.G.nodes[gathering_node]['x'],
                                                self.G.nodes[gathering_node]['y'])
                        connection_line = LineString([demand_point, gathering_point])
                        crossings = self.count_crossings_for_line(connection_line, arterial_lines)
                        self.primary_crossing_matrix[i, j] = crossings
                        print(f"  需求点 {i + 1} → 一级集合点 {j + 1}: {crossings} 次穿越")
                    except Exception as e:
                        print(f"  计算失败 (DP{i + 1} → P1-GP{j + 1}): {e}")

        # === 计算二级集合点穿越次数矩阵 ===
        if self.secondary_gathering_points:
            print("\n计算到二级集合点的穿越次数...")
            num_secondary = len(self.secondary_gathering_points)
            self.secondary_crossing_matrix = np.full((num_demand, num_secondary), -1, dtype=int)

            secondary_list = list(self.secondary_gathering_points)

            for i, demand_item in enumerate(self.region_centroid_nodes):
                demand_point = demand_item[1]  # 获取Point对象

                for j, gathering_node in enumerate(secondary_list):
                    try:
                        gathering_point = Point(self.G.nodes[gathering_node]['x'],
                                                self.G.nodes[gathering_node]['y'])
                        connection_line = LineString([demand_point, gathering_point])
                        crossings = self.count_crossings_for_line(connection_line, arterial_lines)
                        self.secondary_crossing_matrix[i, j] = crossings
                        print(f"  需求点 {i + 1} → 二级集合点 {j + 1}: {crossings} 次穿越")
                    except Exception as e:
                        print(f"  计算失败 (DP{i + 1} → P2-GP{j + 1}): {e}")

        print("\n穿越次数矩阵计算完成")

        # 返回主要使用的矩阵（用于向后兼容）
        return self.primary_crossing_matrix if self.primary_gathering_points else self.secondary_crossing_matrix

    def count_crossings_for_line(self, line, arterial_lines):
        """计算单条线段与干路的穿越次数"""
        crossings = 0
        line_start = Point(line.coords[0])
        line_end = Point(line.coords[-1])

        for arterial in arterial_lines:
            if arterial.geom_type == 'MultiLineString':
                sublines = list(arterial.geoms)
            else:
                sublines = [arterial]

            for subline in sublines:
                try:
                    intersection = line.intersection(subline)
                    if intersection.is_empty:
                        continue

                    if intersection.geom_type == 'Point':
                        # 排除起点和终点的交点
                        if not (line_start.equals(intersection) or line_end.equals(intersection)):
                            crossings += 1
                    elif intersection.geom_type == 'MultiPoint':
                        for pt in intersection.geoms:
                            if not (line_start.equals(pt) or line_end.equals(pt)):
                                crossings += 1
                except Exception as e:
                    # 处理几何计算异常
                    continue

        return crossings

