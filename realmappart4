        print("=" * 60)
        for i in range(len(vulnerable_assignment)):
            j = vulnerable_assignment[i]
            if j != -1:
                demand_node = self.region_centroid_nodes[i][0]
                gathering_node = primary_list[j]
                vulnerable = self.vulnerable_demand.get(demand_node, 0)
                distance = self.primary_distance_matrix.loc[demand_node, gathering_node]
                capacity = self.primary_capacities.get(gathering_node, "未设置")

                print(f"需求点 {i + 1} (Node {demand_node}) -> "
                      f"一级集合点 {j + 1} (Node {gathering_node}, 容量: {capacity})")
                print(f"  ├─ 低能人群数量: {vulnerable}")
                print(f"  └─ 距离: {distance:.1f}m")

        # 显示健全人群分配详情（可能到一级或二级）
        print("\n【健全人群分配详情】（可分配到一级或二级集合点）")
        print("=" * 60)
        for i in range(len(able_assignment)):
            assign_info = able_assignment[i]
            if assign_info != -1:
                demand_node = self.region_centroid_nodes[i][0]
                able = self.able_bodied_demand.get(demand_node, 0)

                gp_type, j = assign_info

                if gp_type == 'primary':
                    gathering_node = primary_list[j]
                    capacity = self.primary_capacities.get(gathering_node, "未设置")
                    type_name = "一级集合点"
                    distance = self.primary_distance_matrix.loc[demand_node, gathering_node]  # ✅ 改这里
                else:  # secondary
                    gathering_node = secondary_list[j]
                    capacity = self.secondary_capacities.get(gathering_node, "未设置")
                    type_name = "二级集合点"
                    distance = self.secondary_distance_matrix.loc[demand_node, gathering_node]  # ✅ 改这里

                print(f"需求点 {i + 1} (Node {demand_node}) -> "
                      f"{type_name} {j + 1} (Node {gathering_node}, 容量: {capacity})")
                print(f"  ├─ 健全人群数量: {able}")
                print(f"  └─ 距离: {distance:.1f}m")
        # 统计汇总
        print("\n【分配统计汇总】")
        print("=" * 60)

        # 统计一级集合点使用情况
        primary_usage = {}
        for node in primary_list:
            primary_usage[node] = {'vulnerable': 0, 'able': 0}

        # 统计低能人群
        for i, j in enumerate(vulnerable_assignment):
            if j != -1:
                gathering_node = primary_list[j]
                demand_node = self.region_centroid_nodes[i][0]
                primary_usage[gathering_node]['vulnerable'] += self.vulnerable_demand.get(demand_node, 0)

        # 统计健全人群到一级的
        for i, assign_info in enumerate(able_assignment):
            if assign_info != -1:
                gp_type, j = assign_info
                if gp_type == 'primary':
                    gathering_node = primary_list[j]
                    demand_node = self.region_centroid_nodes[i][0]
                    primary_usage[gathering_node]['able'] += self.able_bodied_demand.get(demand_node, 0)

        print("\n一级集合点使用情况:")
        for idx, node in enumerate(primary_list):
            capacity = self.primary_capacities.get(node, "未设置")
            vuln = primary_usage[node]['vulnerable']
            able = primary_usage[node]['able']
            total = vuln + able
            print(f"  一级集合点 {idx + 1} (Node {node}, 容量: {capacity}):")
            print(f"    ├─ 低能人群: {vuln}")
            print(f"    ├─ 健全人群: {able}")
            print(f"    └─ 总计: {total}")

        # 统计二级集合点使用情况
