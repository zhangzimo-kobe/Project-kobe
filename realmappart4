         self.current_solution,
         self.gp_total_demand) = state

        self.selected_path_nodes = selected_path_nodes
        self.draw_map(preserve_view=True)  # 可选：避免撤销后视图跳
        print("已撤销上一步操作")

    def run_optimization(self, event):
        """运行双目标遗传算法优化"""
        # 检查必要条件
        if not hasattr(self, 'region_centroid_nodes') or not self.region_centroid_nodes:
            print("错误：没有找到需求点，请先完成选择")
            return

        if not self.primary_gathering_points:
            print("错误：没有选择一级集合点，低能人群必须有一级集合点接收")
            return

        if (not hasattr(self, 'primary_distance_matrix') or self.primary_distance_matrix is None) and \
                (not hasattr(self, 'secondary_distance_matrix') or self.secondary_distance_matrix is None):
            print("错误：没有计算距离矩阵，请先计算距离")
            return

        if self.primary_gathering_points and (
                not hasattr(self, 'primary_distance_matrix') or self.primary_distance_matrix is None):
            print("错误：有一级集合点但未计算其距离矩阵，请先计算距离")
            return

        if not hasattr(self, 'vulnerable_demand') or not hasattr(self, 'able_bodied_demand'):
            print("错误：需求量数据结构未初始化")
            return

        if not self.vulnerable_demand and not self.able_bodied_demand:
            print("错误：没有输入需求量，请先输入需求量")
            return

        # 检查一级集合点总容量是否足够接收所有低能人群
        total_vulnerable = sum(self.vulnerable_demand.values())
        total_primary_capacity = sum(self.primary_capacities.values())

        if total_primary_capacity < total_vulnerable:
            print(f"警告：一级集合点总容量({total_primary_capacity})小于低能人群总需求({total_vulnerable})")
            print("优化可能无法找到可行解")

        try:
            from genetic_algorithm import run_optimization

            print("\n" + "=" * 60)
            print("开始运行分层疏散优化（低能人群→一级，健全人群→一级或二级）")
            print("=" * 60)

            ga, solutions = run_optimization(self)

            if ga and solutions:
                print(f"\n优化完成！找到 {len(solutions)} 个帕累托最优解")

                # 询问是否应用某个解
                if len(solutions) > 0:
                    print("\n可用的帕累托最优解:")
                    for i, sol in enumerate(solutions[:5]):
                        print(f"解 {i + 1}: 距离={sol['objectives'][0]:.1f}, 穿越={sol['objectives'][1]:.1f}")

                    try:
                        choice = input(f"\n请选择要应用的解 (1-{min(len(solutions), 5)}, 或按回车跳过): ")
                        if choice.strip():
                            sol_idx = int(choice) - 1
                            if 0 <= sol_idx < len(solutions):
                                self.apply_solution(solutions[sol_idx])
                    except:
                        print("无效选择，跳过应用解")

        except ImportError:
            print("错误：无法导入遗传算法模块，请确保 genetic_algorithm.py 文件存在")
        except Exception as e:
            print(f"优化过程中出现错误: {e}")
            import traceback
            traceback.print_exc()

    def apply_solution(self, solution):
        """应用优化解到可视化"""
        self.current_solution = solution
        print(f"\n应用解决方案:")
        print(f"总距离: {solution['objectives'][0]:.1f} 人·米")
        print(f"总穿越: {solution['objectives'][1]:.1f} 人·次")

        # 获取分配方案
        vulnerable_assignment = solution.get('vulnerable_assignment', [])
        able_assignment = solution.get('able_assignment', [])

        primary_list = list(self.primary_gathering_points)
        secondary_list = list(self.secondary_gathering_points)

        # ===== Stage 2 input: aggregate total demand at each gathering point (ignore types) =====
        gp_total = defaultdict(int)

        # 低能人群（一定到一级集合点）
        for i, j in enumerate(vulnerable_assignment):
            if j != -1:
                demand_node = self.region_centroid_nodes[i][0]
                gp_node = primary_list[j]
                gp_total[gp_node] += int(self.vulnerable_demand.get(demand_node, 0))

        # 健全人群（到一级或二级）
        for i, assign_info in enumerate(able_assignment):
            if assign_info is None or assign_info == -1:
                continue
            demand_node = self.region_centroid_nodes[i][0]
            gp_type, j = assign_info
            if gp_type == 'primary':
                gp_node = primary_list[j]
            else:
                gp_node = secondary_list[j]
            gp_total[gp_node] += int(self.able_bodied_demand.get(demand_node, 0))

        self.gp_total_demand = dict(gp_total)

        print("\n【Stage2】集合点总需求量汇总（用于公交二阶段）:")
        for gp_node, total in self.gp_total_demand.items():
            print(f"  集合点 Node {gp_node}: {total}")

        # 显示低能人群分配详情（只到一级集合点）
