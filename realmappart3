                        print("错误：需求量必须为非负整数")
                except ValueError:
                    print("错误：请输入有效的整数")

            # 输入健全人群需求量
            while True:
                try:
                    able_str = input(f"请输入需求点 {i + 1} 的【健全人群】需求量（正整数）: ")
                    able = int(able_str)
                    if able >= 0:  # 允许为0
                        self.able_bodied_demand[centroid_id] = able
                        print(f"  ✓ 健全人群需求量: {able}")
                        break
                    else:
                        print("错误：需求量必须为非负整数")
                except ValueError:
                    print("错误：请输入有效的整数")

            # 显示该需求点的总计
            total = vulnerable + able
            print(f"  → 需求点 {i + 1} 总需求量: {total} (低能: {vulnerable}, 健全: {able})")

        # 显示所有需求点的汇总
